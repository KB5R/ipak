Screen {
    background: #15191d;
    color: #d7dde3;
}
* {
    scrollbar-background: #20272e;
    scrollbar-background-hover: #28323c;
    scrollbar-background-active: #28323c;
    scrollbar-color: #46515d;
    scrollbar-color-hover: #6c879b;
    scrollbar-color-active: #8bb9d4;
}
DataTable {
    background: #15191d;
    color: #d7dde3;
    border-left: blank;
}
DataTable:focus { border-left: solid #8bb9d4; }
DataTable > .datatable--header { background: #20272e; color: #d7dde3; text-style: bold; }
DataTable > .datatable--cursor { background: #28323c; color: #d7dde3; }
DataTable:focus > .datatable--cursor { background: #375269; text-style: bold; }
DataTable > .datatable--fixed { background: #15191d; color: #d7dde3; }
DataTable > .datatable--fixed-cursor { background: #28323c; color: #d7dde3; }
DataTable:focus > .datatable--fixed-cursor { background: #375269; color: #d7dde3; text-style: bold; }
OptionList { background: #15191d; color: #d7dde3; }
OptionList > .option-list--option-highlighted { background: #28323c; color: #d7dde3; }
OptionList:focus > .option-list--option-highlighted { background: #375269; color: #d7dde3; text-style: bold; }
Button, Button.-primary { background: #28323c; color: #d7dde3; }
Button:focus, Button.-primary:focus { background: #375269; text-style: bold; }
Input { background: #28323c; color: #d7dde3; }
Input:focus { background: #375269; border: tall #8bb9d4; }
TopBar {
    dock: top;
    height: 2;
    padding: 0 1;
    border-bottom: solid #46515d;
}
#server { width: 1fr; }
#connection { width: auto; color: #aebbc7; }
ContextFooter {
    dock: bottom;
    height: 3;
    padding: 0 1;
    border-top: solid #46515d;
    background: #20272e;
}
#workspace { height: 1fr; }
#sections {
    width: 19;
    height: 1fr;
    padding: 0;
    border: none;
    border-right: solid #46515d;
    background: #15191d;
}
#sections:focus { border-right: solid #8bb9d4; }
#sections > .option-list--option { padding: 0 1; }
#sections > .option-list--option-highlighted { background: #28323c; }
#sections:focus > .option-list--option-highlighted { background: #375269; text-style: bold; }
#main { width: 1fr; padding: 0 1; }
#users-pane { height: 1fr; }
.heading { height: auto; min-height: 1; text-style: bold; margin-bottom: 1; }
#filter {
    height: 1;
    padding: 0;
    margin-bottom: 1;
    border: none;
    background: #28323c;
}
#filter:focus { background: #375269; }
#selection { height: auto; color: #c7ddeb; margin-bottom: 1; }
#scope { height: auto; color: #aebbc7; margin-bottom: 1; }
StateMessage { height: auto; padding: 1; border: blank; }
StateMessage:focus { border-left: solid #8bb9d4; }
#users { height: 1fr; }
#detail-title { margin: 0 2 1 2; }
#detail-body { padding: 0 1; border-left: blank; }
#detail-body:focus { border-left: solid #8bb9d4; }
#detail-state { height: auto; }
#detail-fields { height: auto; }
.field { height: auto; min-height: 1; margin-bottom: 1; }
.field-label { width: 20; color: #aebbc7; }
.field-value { width: 1fr; height: auto; }
.detail-note { color: #aebbc7; height: auto; }
HelpScreen { align: center middle; background: #000000 45%; }
#help-dialog {
    width: 66;
    max-width: 96%;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    border: solid #8bb9d4;
    background: #20272e;
    overflow-y: auto;
}
#help-dialog Static { height: auto; }
.help-close { margin-top: 1; color: #c7ddeb; }
ModalScreen { align: center middle; background: #000000 45%; }
.dialog {
    width: 72;
    max-width: 96%;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    border: solid #8bb9d4;
    background: #20272e;
}
.dialog Static { height: auto; }
.dialog OptionList { height: auto; max-height: 12; }
.dialog-buttons { height: auto; margin-top: 1; }
.dialog-buttons Button { min-width: 10; margin-right: 1; }
.review-dialog { height: 85%; }
.review-content { height: 1fr; }
#results-body { padding: 1 2; }
#results { height: auto; }
.form-body { padding: 0 2; height: 1fr; }
.form-label { height: 1; margin-top: 1; color: #aebbc7; }
.form-input { height: 1; border: none; padding: 0 1; }
.form-input:focus { background: #375269; }
.form-status { height: auto; color: #e5c48a; margin: 0 2; }
.picker-dialog { height: 85%; }
#picker-table { height: 1fr; }
#picker-status { height: auto; }
#membership-panes { height: 1fr; }
.membership-pane { width: 1fr; padding: 0 1; }
.membership-pane UserTable { height: 1fr; }
.membership-pane Input { height: 1; border: none; }
#pending { height: auto; max-height: 3; padding: 0 1; color: #e5c48a; }
#directory-pane { height: 1fr; }
#directory-table { height: 1fr; }
#directory-status { height: auto; margin-bottom: 1; }
#directory-filter { height: 1; border: none; }
#group-types { height: auto; }
#group-types Button { height: 1; border: none; min-width: 15; }
#record-body { padding: 0 2; }
#record-fields { height: auto; }
#bulk-table, #rule-properties { height: 1fr; }
#bulk-status, #rule-status { max-height: 4; }
#sudo-options { height: 1fr; }
#bulk-menu { height: 1fr; border: none; }
